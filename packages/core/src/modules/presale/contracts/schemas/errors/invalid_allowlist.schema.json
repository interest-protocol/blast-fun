{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/presale/contracts/errors/invalid_allowlist.schema.json",
  "title": "invalid_allowlist error",
  "description": "HTTP 422; route-specific fields sit inside error (CL-10), and the body never carries retryAfterSeconds (CL-23).",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "const": "invalid_allowlist"
        },
        "message": {
          "$ref": "../defs.schema.json#/$defs/message"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "row": {
                "$ref": "../defs.schema.json#/$defs/row"
              },
              "reason": {
                "$ref": "../defs.schema.json#/$defs/message"
              }
            },
            "required": [
              "row",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "code",
        "message",
        "rows"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
