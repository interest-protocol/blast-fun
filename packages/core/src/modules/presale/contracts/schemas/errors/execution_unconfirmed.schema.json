{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/presale/contracts/errors/execution_unconfirmed.schema.json",
  "title": "execution_unconfirmed error",
  "description": "HTTP 504; route-specific fields sit inside error (CL-10), and the body never carries retryAfterSeconds (CL-23).",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "const": "execution_unconfirmed"
        },
        "message": {
          "$ref": "../defs.schema.json#/$defs/message"
        },
        "digest": {
          "$ref": "../defs.schema.json#/$defs/digest"
        }
      },
      "required": [
        "code",
        "message",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
