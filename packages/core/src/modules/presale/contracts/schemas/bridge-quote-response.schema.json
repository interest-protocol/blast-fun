{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/presale/contracts/bridge-quote-response.schema.json",
  "title": "Bridge quote",
  "description": "GET /api/presale/bridge/quote 200 (CL-7); max_fee is USDC atoms.",
  "type": "object",
  "properties": {
    "fast": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "eta_seconds": {
              "$ref": "defs.schema.json#/$defs/count"
            },
            "fee_bps": {
              "$ref": "defs.schema.json#/$defs/fee_bps"
            },
            "max_fee": {
              "$ref": "defs.schema.json#/$defs/uint"
            },
            "allowance_ok": {
              "type": "boolean"
            }
          },
          "required": [
            "eta_seconds",
            "fee_bps",
            "max_fee",
            "allowance_ok"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "standard": {
      "type": "object",
      "properties": {
        "eta_seconds": {
          "$ref": "defs.schema.json#/$defs/count"
        },
        "fee_bps": {
          "$ref": "defs.schema.json#/$defs/fee_bps"
        }
      },
      "required": [
        "eta_seconds",
        "fee_bps"
      ],
      "additionalProperties": false
    },
    "destination_domain": {
      "const": 8
    },
    "forwarding": {
      "enum": [
        "circle",
        "blast"
      ]
    },
    "destination_caller": {
      "$ref": "defs.schema.json#/$defs/address"
    },
    "hook_data": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x([0-9a-fA-F]{2})+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "fast",
    "standard",
    "destination_domain",
    "forwarding",
    "destination_caller",
    "hook_data"
  ],
  "additionalProperties": false
}
