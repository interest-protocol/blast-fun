{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/presale/contracts/ws-presale-lifecycle.schema.json",
  "title": "presale lifecycle message",
  "description": "presale:<presale_id> and presale_feed: the new lifecycle with the full projection, never a delta (CL-4); a log message has no topic and reaches each connection once (CL-20); a replayed message carries replayed: true and may omit projection (CL-26).",
  "type": "object",
  "properties": {
    "type": {
      "const": "lifecycle"
    },
    "cursor": {
      "$ref": "defs.schema.json#/$defs/event_cursor"
    },
    "checkpoint": {
      "$ref": "defs.schema.json#/$defs/checkpoint"
    },
    "timestamp_ms": {
      "$ref": "defs.schema.json#/$defs/timestamp_ms"
    },
    "replayed": {
      "description": "Present, and true, only on a message replayed on resume (CL-26).",
      "const": true
    },
    "presale_id": {
      "$ref": "defs.schema.json#/$defs/address"
    },
    "lifecycle": {
      "$ref": "defs.schema.json#/$defs/lifecycle"
    },
    "projection": {
      "$ref": "presale-projection.schema.json"
    }
  },
  "required": [
    "type",
    "cursor",
    "checkpoint",
    "timestamp_ms",
    "presale_id",
    "lifecycle"
  ],
  "anyOf": [
    {
      "description": "A live message carries the full projection.",
      "type": "object",
      "properties": {
        "projection": {
          "$ref": "presale-projection.schema.json"
        }
      },
      "required": [
        "projection"
      ]
    },
    {
      "description": "A replayed message may omit it (CL-26).",
      "type": "object",
      "properties": {
        "replayed": {
          "const": true
        }
      },
      "required": [
        "replayed"
      ]
    }
  ],
  "additionalProperties": false
}
