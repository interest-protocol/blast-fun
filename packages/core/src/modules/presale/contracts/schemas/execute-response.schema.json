{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/presale/contracts/execute-response.schema.json",
  "title": "Execute response",
  "description": "POST /api/presale/sponsor/{reservation_id}/execute 200; gas_used is net MIST, computation + storage - rebate (CL-5).",
  "type": "object",
  "properties": {
    "digest": {
      "$ref": "defs.schema.json#/$defs/digest"
    },
    "effects": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "success",
            "failure"
          ]
        },
        "gas_used": {
          "$ref": "defs.schema.json#/$defs/int"
        }
      },
      "required": [
        "status",
        "gas_used"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "digest",
    "effects"
  ],
  "additionalProperties": false
}
