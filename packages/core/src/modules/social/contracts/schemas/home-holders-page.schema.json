{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/home-holders-page.schema.json",
  "title": "Home holders page",
  "description": "Redesign gap 3 (contracts/coin-market.ts HomeHoldersPage): the coin's largest holders with each one's cost basis by the portfolio's rule (R3-32); a named account's figures only when it shares its portfolio.",
  "type": "object",
  "properties": {
    "coin_type": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512
    },
    "presale_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      ]
    },
    "decimals": {
      "type": "integer",
      "minimum": 0
    },
    "price_usd": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      ]
    },
    "price_as_of_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "holders": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/holder"
      }
    },
    "as_of": {
      "$ref": "https://blast-v2.invalid/social/contracts/as-of.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "holder": {
      "type": "object",
      "properties": {
        "actor": {
          "oneOf": [
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/accountActor"
            },
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/addressActor"
            }
          ]
        },
        "balance": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "share_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "value_usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          ]
        },
        "average_entry_usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          ]
        },
        "why": {
          "description": "A named holder's latest active why on its own post about the coin; null without one or for an unnamed wallet.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          ]
        },
        "basis_usd": {
          "$ref": "https://blast-v2.invalid/social/contracts/portfolio-response.schema.json#/$defs/basis_usd"
        },
        "basis_complete": {
          "$ref": "https://blast-v2.invalid/social/contracts/portfolio-response.schema.json#/$defs/basis_complete"
        },
        "pnl_usd": {
          "$ref": "https://blast-v2.invalid/social/contracts/portfolio-response.schema.json#/$defs/pnl_usd"
        },
        "pnl_multiple": {
          "$ref": "https://blast-v2.invalid/social/contracts/portfolio-response.schema.json#/$defs/pnl_multiple"
        }
      },
      "additionalProperties": false,
      "required": [
        "actor",
        "balance",
        "share_bps",
        "value_usd",
        "average_entry_usd",
        "why",
        "basis_usd",
        "basis_complete",
        "pnl_usd",
        "pnl_multiple"
      ]
    }
  },
  "required": [
    "coin_type",
    "presale_id",
    "decimals",
    "price_usd",
    "price_as_of_ms",
    "holders",
    "as_of"
  ]
}
