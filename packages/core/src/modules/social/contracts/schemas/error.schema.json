{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/error.schema.json",
  "title": "Social route error",
  "description": "Every social route error: { error: { code, message, ...extra } }. The body never carries a retry time (Retry-After is the carrier).",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z_]{0,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "code",
        "message"
      ],
      "propertyNames": {
        "not": {
          "enum": [
            "retryAfterSeconds",
            "retry_after_seconds"
          ]
        }
      }
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
