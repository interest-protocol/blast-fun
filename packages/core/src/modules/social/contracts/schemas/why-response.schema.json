{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/why-response.schema.json",
  "title": "Social why created",
  "description": "201 answer of POST /api/social/items/{entry_id}/why: the new why's id and its stored text (NFC, trimmed).",
  "type": "object",
  "properties": {
    "why_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1120
    }
  },
  "required": [
    "why_id",
    "text"
  ],
  "additionalProperties": false
}
