{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/home-coins-page.schema.json",
  "title": "Home coins",
  "description": "GET /api/social/home and GET /api/social/home/coins 200 (public, s-maxage=10): one page of coin items with their window's participation grouped by identity, bounded by the watermark. The same for every caller; no viewer field.",
  "type": "object",
  "properties": {
    "coins": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/coin"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}::[A-Za-z_][A-Za-z0-9_]{0,127}::[A-Za-z_][A-Za-z0-9_]{0,127}$"
          }
        ]
      }
    },
    "next_cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      ]
    },
    "window": {
      "enum": [
        "1h",
        "24h"
      ]
    },
    "clock_ms": {
      "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
    },
    "as_of": {
      "$ref": "https://blast-v2.invalid/social/contracts/as-of.schema.json"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "pages": {
      "type": "integer",
      "minimum": 1
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "pool_volumes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/amount"
            }
          }
        ]
      }
    },
    "ranked": {
      "description": "Discover, only when the request has `ranked=1`: how many of `total` have data on the sort's keys (Trending: window volume, breadth, activity or recency). They lead the order, so the rest start at this position.",
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "coins",
    "window",
    "clock_ms",
    "as_of"
  ],
  "additionalProperties": false,
  "$defs": {
    "amount": {
      "type": "object",
      "properties": {
        "quote_type": {
          "type": "string",
          "minLength": 1
        },
        "quote_symbol": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "quote_decimals": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18
            }
          ]
        },
        "atoms": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Atoms as a decimal string, exact."
        },
        "usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          ]
        },
        "usd_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "quote_type",
        "quote_symbol",
        "quote_decimals",
        "atoms",
        "usd",
        "usd_complete"
      ],
      "additionalProperties": false
    },
    "side": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "amounts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/amount"
              }
            },
            "tokens": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$",
                  "description": "Atoms as a decimal string, exact."
                }
              ]
            },
            "latest_ms": {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
            }
          },
          "required": [
            "count",
            "amounts",
            "tokens",
            "latest_ms"
          ],
          "additionalProperties": false
        }
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "activity_id": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+:[0-9]+:[0-9]+$"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^a:[0-9]+:[0-9]+:[0-9]+:[0-9]+$"
        },
        "kind": {
          "enum": [
            "trade_buy",
            "trade_sell",
            "presale_commit",
            "presale_claim"
          ]
        },
        "occurred_at_ms": {
          "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
        },
        "digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "quote": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/amount"
            }
          ]
        },
        "tokens": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "description": "Atoms as a decimal string, exact."
            }
          ]
        },
        "refund": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "description": "Atoms as a decimal string, exact."
            }
          ]
        },
        "has_why": {
          "type": "boolean"
        }
      },
      "required": [
        "activity_id",
        "entry_id",
        "kind",
        "occurred_at_ms",
        "digest",
        "quote",
        "tokens",
        "refund",
        "has_why"
      ],
      "additionalProperties": false
    },
    "participant": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(c:[a-z0-9_]{3,20}|w:0x[0-9a-f]{64})$"
        },
        "actor": {
          "oneOf": [
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/accountActor"
            },
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/addressActor"
            }
          ]
        },
        "followers": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "buys": {
          "$ref": "#/$defs/side"
        },
        "sells": {
          "$ref": "#/$defs/side"
        },
        "commits": {
          "$ref": "#/$defs/side"
        },
        "claims": {
          "$ref": "#/$defs/side"
        },
        "latest_ms": {
          "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
        },
        "latest_kind": {
          "enum": [
            "trade_buy",
            "trade_sell",
            "presale_commit",
            "presale_claim"
          ]
        },
        "events_total": {
          "type": "integer",
          "minimum": 1
        },
        "events": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "events_more": {
          "type": "boolean"
        },
        "relation": {
          "enum": [
            "followed"
          ]
        }
      },
      "required": [
        "key",
        "actor",
        "followers",
        "buys",
        "sells",
        "commits",
        "claims",
        "latest_ms",
        "latest_kind",
        "events_total"
      ],
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "pool",
            "followed"
          ]
        },
        "window": {
          "enum": [
            "1h",
            "24h"
          ]
        },
        "from_ms": {
          "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
        },
        "to_ms": {
          "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
        },
        "participants": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "buyers": {
          "type": "integer",
          "minimum": 0
        },
        "sellers": {
          "type": "integer",
          "minimum": 0
        },
        "backers": {
          "type": "integer",
          "minimum": 0
        },
        "claimers": {
          "type": "integer",
          "minimum": 0
        },
        "bought": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/amount"
          }
        },
        "sold": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/amount"
          }
        },
        "committed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/amount"
          }
        },
        "latest_ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
            }
          ]
        },
        "preview": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/participant"
          }
        }
      },
      "required": [
        "scope",
        "window",
        "from_ms",
        "to_ms",
        "participants",
        "events",
        "buyers",
        "sellers",
        "backers",
        "claimers",
        "bought",
        "sold",
        "committed",
        "latest_ms",
        "preview"
      ],
      "additionalProperties": false
    },
    "coin": {
      "type": "object",
      "properties": {
        "presale_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "coin_type": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon_url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "lifecycle": {
          "type": "string",
          "minLength": 1
        },
        "venue": {
          "type": "string"
        },
        "tradable": {
          "type": "boolean"
        },
        "opened_ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
            }
          ]
        },
        "launched_ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
            }
          ]
        },
        "quote": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18
            }
          },
          "required": [
            "type",
            "symbol",
            "decimals"
          ],
          "additionalProperties": false
        },
        "price_usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          ]
        },
        "price_as_of_ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
            }
          ]
        },
        "change_24h_bps": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "spark": {
          "type": "array",
          "maxItems": 292,
          "description": "The 24 h USD price line a sparkline draws, oldest first: [the price's own time in ms, its USD price]. Empty without two points; a presale has none.",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
              },
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            ],
            "items": false,
            "minItems": 2
          }
        },
        "holders": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "holders_as_of_ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
            }
          ]
        },
        "fdv_usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          ]
        },
        "activity": {
          "$ref": "#/$defs/activity"
        },
        "discussion": {
          "type": "object",
          "properties": {
            "posts": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "posts"
          ],
          "additionalProperties": false
        },
        "rank": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0
            },
            "why": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "score",
            "why"
          ],
          "additionalProperties": false
        },
        "qualified": {
          "enum": [
            "activity",
            "discussion"
          ]
        },
        "sale": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "start_ms": {
              "type": "integer",
              "minimum": 0
            },
            "end_ms": {
              "type": "integer",
              "minimum": 0
            },
            "raise_target": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "raised": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "participants": {
              "type": "integer",
              "minimum": 0
            },
            "savers": {
              "description": "Accounts with a verified X link that have the sale saved now. Present only on a Discover read that asks for presales (`presales=1`).",
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "start_ms",
            "end_ms",
            "raise_target",
            "raised",
            "participants"
          ],
          "additionalProperties": false
        },
        "top_holders": {
          "type": "object",
          "properties": {
            "holders": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/holder"
              }
            },
            "share_bps": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "holders",
            "share_bps"
          ],
          "additionalProperties": false
        },
        "launch_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "A curve coin's launch, the key of its coin page; null for a sale's coin."
        },
        "verified_team": {
          "type": "boolean",
          "description": "R3-23: Blast checked who is behind the coin (social_sale_trust for a sale, social_coin_trust for a bonding-curve coin); sent only when true."
        },
        "mobile_market": {
          "type": "object",
          "properties": {
            "market_cap_usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "change_1h_bps": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "market_cap_usd",
            "change_1h_bps"
          ],
          "additionalProperties": false
        },
        "live_inputs": {
          "type": "object",
          "properties": {
            "total_supply": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "circulating_supply": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "open_1h_usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d+(?:\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "open_24h_usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d+(?:\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "baselines_until_ms": {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
            },
            "price_checkpoint": {
              "type": "integer",
              "minimum": 0
            },
            "open_24h_until_ms": {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
            }
          },
          "required": [
            "total_supply",
            "circulating_supply",
            "open_1h_usd",
            "open_24h_usd",
            "baselines_until_ms"
          ],
          "additionalProperties": false
        },
        "dex_volume": {
          "type": "object",
          "properties": {
            "usd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "usd_complete": {
              "type": "boolean"
            },
            "venues": {
              "type": "object",
              "properties": {
                "cetus": {
                  "type": "object",
                  "properties": {
                    "usd": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "usd_complete": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "usd",
                    "usd_complete"
                  ],
                  "additionalProperties": false
                },
                "bluefin": {
                  "type": "object",
                  "properties": {
                    "usd": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "usd_complete": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "usd",
                    "usd_complete"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "cetus",
                "bluefin"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "usd",
            "usd_complete",
            "venues"
          ],
          "additionalProperties": false,
          "description": "Gross Cetus and Bluefin swap volume in the activity window. For each total, usd_complete requires full coverage and prices for all swaps. Otherwise a USD sum is a lower bound and null means unknown."
        },
        "change_24h_from_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "First priced observation when the comparison covers less than 24 hours.",
          "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
        },
        "curve": {
          "description": "A Blast bonding curve coin's curve: its lifecycle, its progress toward graduation in basis points (10000 once ready to migrate or migrated), and the quote atoms left to its target; progress and remaining are null while the target is unknown. Null for any other coin. Present only when the read asks for it (`curve=1`).",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "lifecycle": {
                  "type": "string",
                  "enum": [
                    "opening_round",
                    "live",
                    "migration_ready",
                    "migrated"
                  ]
                },
                "progress_bps": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quote_remaining": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "lifecycle",
                "progress_bps",
                "quote_remaining"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "graduated_ms": {
          "description": "When a curve coin graduated: its first DEX pool's creation. Null for a curve still filling and for any other coin. Present only with `curve=1`.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/millis"
            }
          ]
        }
