{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/wallet-coins-response.schema.json",
  "title": "The Blast wallet and its coins",
  "description": "GET /api/social/me/wallet: the account's Blast wallet, who signs for it, how its network fees are paid, and held coins. With page parameters, returns up to 20 filtered holdings and separate common, selected and favourite coin balances.",
  "type": "object",
  "properties": {
    "address": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "signer": {
      "enum": [
        "privy",
        "wallet"
      ]
    },
    "fee": {
      "enum": [
        "sponsored",
        "wallet"
      ]
    },
    "coins": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "coin_type": {
                "type": "string",
                "minLength": 8,
                "maxLength": 512,
                "pattern": "^0x[0-9a-f]{64}::[A-Za-z_][A-Za-z0-9_]{0,127}::[A-Za-z_][A-Za-z0-9_]{0,127}(<.+>)?$"
              },
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "decimals": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 255
              },
              "atoms": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "usd_price": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "value_usd": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "icon_url": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2048
              },
              "presale": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "presale_id": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{64}$"
                      },
                      "venue": {
                        "type": "string",
                        "maxLength": 32
                      },
                      "trading": {
                        "type": "boolean"
                      },
                      "multiple": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{4}$"
                      }
                    },
                    "required": [
                      "presale_id",
                      "venue",
                      "trading",
                      "multiple"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "coin_type",
              "symbol",
              "name",
              "decimals",
              "atoms",
              "usd_price",
              "value_usd",
              "icon_url",
              "presale"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "as_of_ms": {
      "type": "integer",
      "minimum": 0
    },
    "listing": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "page_size": {
          "const": 20
        },
        "value_usd": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "extra_coins": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "$ref": "#/properties/coins/oneOf/1/items"
          }
        }
      },
      "required": [
        "page",
        "total",
        "page_size",
        "value_usd",
        "extra_coins"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "address",
    "signer",
    "fee",
    "coins",
    "as_of_ms"
  ],
  "additionalProperties": false
}
