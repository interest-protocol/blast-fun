{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/as-of.schema.json",
  "title": "Chain freshness of a social read",
  "description": "From chain_read_v1.watermark: the slowest pipeline's checkpoint and timestamp, and their age when read.",
  "type": "object",
  "properties": {
    "checkpoint": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "lag_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "checkpoint",
    "timestamp_ms",
    "lag_ms"
  ],
  "additionalProperties": false
}
