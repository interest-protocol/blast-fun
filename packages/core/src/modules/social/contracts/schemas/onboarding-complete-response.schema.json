{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/onboarding-complete-response.schema.json",
  "title": "Onboarding state after completion",
  "description": "POST /api/social/onboarding/complete 200: the stored privacy and sharing start. An account that had already finished gets its current state back unchanged.",
  "type": "object",
  "properties": {
    "onboarding": {
      "type": "object",
      "properties": {
        "shown": {
          "const": true
        },
        "completed": {
          "const": true
        }
      },
      "required": [
        "shown",
        "completed"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "enum": [
        "public",
        "private"
      ]
    },
    "sharing_since_ms": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    }
  },
  "required": [
    "onboarding",
    "privacy",
    "sharing_since_ms"
  ],
  "additionalProperties": false
}
