{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/transfer-response.schema.json",
  "title": "A withdrawal",
  "description": "PUT /api/social/me/transfers/{request_id}: the recorded withdrawal and where it stands.",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "coin_type": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^0x[0-9a-f]{64}::[A-Za-z_][A-Za-z0-9_]{0,127}::[A-Za-z_][A-Za-z0-9_]{0,127}(<.+>)?$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "recipient": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "fee": {
      "enum": [
        "sponsored",
        "wallet"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "submitted",
        "confirmed",
        "failed"
      ]
    },
    "digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "failure": {
      "enum": [
        "execution_failed",
        "mismatch",
        null
      ]
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "settled_at_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "request_id",
    "coin_type",
    "amount",
    "recipient",
    "fee",
    "status",
    "digest",
    "failure",
    "created_at_ms",
    "settled_at_ms"
  ],
  "additionalProperties": false
}
