{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/blast-workspace-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "account_id",
    "revision",
    "saved_at_ms",
    "workspace"
  ],
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "saved_at_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace": {
      "anyOf": [
        {
          "$ref": "https://blast-v2.invalid/social/contracts/blast-workspace-setup.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
