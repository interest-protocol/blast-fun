{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/profile-calls-response.schema.json",
  "title": "Social profile calls",
  "description": "GET /api/social/profiles/{callsign}/calls 200: the account's presale calls (OA-9: its named commits per presale) and its track record (OA-14). Public: the same for every caller.",
  "type": "object",
  "properties": {
    "calls": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "presale": {
            "type": "object",
            "description": "A presale as profile rows show it.",
            "properties": {
              "presale_id": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "icon_url": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "open",
                  "closed",
                  "funded",
                  "trading",
                  "cancelled"
                ]
              },
              "venue": {
                "type": "string"
              },
              "start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "end_ms": {
                "type": "integer",
                "minimum": 0
              },
              "fill_pct": {
                "type": "integer",
                "minimum": 0
              },
              "quote_symbol": {
                "description": "R3-40: the sale's quote coin (USDC or SUI).",
                "type": "string",
                "minLength": 1
              },
              "quote_decimals": {
                "type": "integer",
                "minimum": 0
              },
              "launched_ms": {
                "description": "R3-85: when the sale coin launched (its presale_lifecycle migrated time); null until it has.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              },
              "first_unlock_ms": {
                "description": "R3-85: the sale's first unlock, the earliest cliff end of its vesting_schedules; null without one.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              },
              "coin_type": {
                "type": "string",
                "minLength": 1,
                "description": "Canonical sale coin type; optional for older cached responses."
              },
              "verified_team": {
                "type": "boolean",
                "description": "R3-23: Blast checked who is behind the sale (social_sale_trust); sent only when true."
              }
            },
            "required": [
              "presale_id",
              "symbol",
              "name",
              "icon_url",
              "status",
              "venue",
              "start_ms",
              "end_ms",
              "fill_pct",
              "quote_symbol",
              "quote_decimals",
              "launched_ms",
              "first_unlock_ms"
            ],
            "additionalProperties": false
          },
          "committed_usd": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "committed_atoms": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "R3-40: the same commitment in quote atoms."
          },
          "entry_price_usd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            ]
          },
          "price_usd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            ]
          },
          "multiple": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{4}$"
              }
            ]
          },
          "value_usd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
              }
            ]
          },
          "pnl_usd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
              }
            ]
          },
          "last_commit_ms": {
            "type": "integer",
            "minimum": 0
          },
          "why": {
            "description": "The account's latest active why on one of the counted commits; null without one.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            ]
          },
          "series": {
            "type": "null",
            "description": "Price history for the sparkline: deferred (OA-11)."
          }
        },
        "required": [
          "presale",
          "committed_usd",
          "committed_atoms",
          "entry_price_usd",
          "price_usd",
          "multiple",
          "value_usd",
          "pnl_usd",
          "last_commit_ms",
          "why",
          "series"
        ],
        "additionalProperties": false
      }
    },
    "track_record": {
      "type": "object",
      "properties": {
        "presales_backed": {
          "type": "integer",
          "minimum": 0
        },
        "launched": {
          "type": "integer",
          "minimum": 0
        },
        "pnl_usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          ]
        }
      },
      "required": [
        "presales_backed",
        "launched",
        "pnl_usd"
      ],
      "additionalProperties": false
    },
    "as_of": {
      "$ref": "https://blast-v2.invalid/social/contracts/as-of.schema.json"
    }
  },
  "required": [
    "calls",
    "track_record",
    "as_of"
  ],
  "additionalProperties": false
}
