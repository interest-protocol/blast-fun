{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/transactions-page.schema.json",
  "title": "Transaction log page",
  "description": "GET /api/social/me/transactions 200: one keyset page of the caller's logged transactions, newest first on (created_at_ms, tx_id) (private, never cached).",
  "type": "object",
  "properties": {
    "transactions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "tx_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "kind": {
            "enum": [
              "commit",
              "claim_refund",
              "claim_tokens",
              "claim_vesting",
              "collect_fees",
              "claim_residuals",
                "claim_launch_fees",
                "claim_launch_lp_fees",
              "deposit",
              "withdraw",
              "trade_buy",
              "trade_sell"
            ]
          },
          "state": {
            "enum": [
              "submitted",
              "confirmed",
              "failed"
            ]
          },
          "digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "failure_code": {
            "enum": [
              "execution_failed",
              "mismatch",
              "dry_run_failed",
              "sponsor_refused",
              "rejected",
              "expired",
              "quote_expired",
              "price_moved",
              "insufficient_balance",
              "pool_unavailable",
              null
            ]
          },
          "presale_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "coin_type": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 8,
            "maxLength": 512
          },
          "amount": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "quote_type": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 8,
            "maxLength": 512
          },
          "quote_amount": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "usd_value": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]{0,17})\\.[0-9]{2}$"
          },
          "recipient": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "created_at_ms": {
            "type": "integer",
            "minimum": 1
          },
          "settled_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "explorer_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://(suiscan\\.xyz/mainnet/tx|suivision\\.xyz/txblock)/[1-9A-HJ-NP-Za-km-z]{32,44}$"
          }
        },
        "required": [
          "tx_id",
          "kind",
          "state",
          "digest",
          "failure_code",
          "presale_id",
          "coin_type",
          "amount",
          "quote_type",
          "quote_amount",
          "usd_value",
          "recipient",
          "created_at_ms",
          "settled_at_ms",
          "explorer_url"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      ]
    },
    "explorer": {
      "enum": [
        "suiscan",
        "suivision"
      ]
    }
  },
  "required": [
    "transactions",
    "next_cursor",
    "explorer"
  ],
  "additionalProperties": false
}
