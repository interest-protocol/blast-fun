{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/home-chart-trades-page.schema.json",
  "title": "Home chart trades page",
  "description": "Redesign gap 7 (contracts/coin-market.ts HomeChartTradesPage): the chart's big trades (GET /api/social/home/trades) or the viewer's own (GET /api/social/me/home/trades), newest first.",
  "type": "object",
  "properties": {
    "coin_type": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512
    },
    "from_ms": {
      "type": "integer",
      "minimum": 0
    },
    "to_ms": {
      "type": "integer",
      "minimum": 0
    },
    "min_usd": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1000
    },
    "trades": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/trade"
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "as_of": {
      "$ref": "https://blast-v2.invalid/social/contracts/as-of.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "trade": {
      "type": "object",
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^a:[0-9]{1,18}:[0-9]{1,10}:[0-9]{1,10}:[0-9]{1,10}$"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ]
        },
        "coin_atoms": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "quote_atoms": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          ]
        },
        "actor": {
          "oneOf": [
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/accountActor"
            },
            {
              "$ref": "https://blast-v2.invalid/social/contracts/feed-item.schema.json#/$defs/addressActor"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "entry_id",
        "digest",
        "timestamp_ms",
        "side",
        "coin_atoms",
        "quote_atoms",
        "usd",
        "actor"
      ]
    }
  },
  "required": [
    "coin_type",
    "from_ms",
    "to_ms",
    "min_usd",
    "trades",
    "truncated",
    "as_of"
  ]
}
