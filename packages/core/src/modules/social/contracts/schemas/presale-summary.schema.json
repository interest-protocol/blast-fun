{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/presale-summary.schema.json",
  "title": "Presale summary",
  "description": "One sale as a list row shows it (contracts/presales.ts SocialPresaleSummary).",
  "type": "object",
  "properties": {
    "presale_id": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "icon_url": {
      "type": "string"
    },
    "phase": {
      "enum": [
        "pending",
        "open",
        "closed",
        "funded",
        "trading",
        "cancelled"
      ]
    },
    "venue": {
      "type": "string"
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0
    },
    "ended_ms": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "launched_ms": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "target_usd": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        }
      ]
    },
    "raised_usd": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        }
      ]
    },
    "quote_symbol": {
      "description": "R3-40: the sale's quote coin (USDC or SUI). A USDC sale reads in dollars (the *_usd fields); any other quote reads in its own coin from the *_atoms figures and quote_decimals.",
      "type": "string",
      "minLength": 1
    },
    "quote_decimals": {
      "type": "integer",
      "minimum": 0
    },
    "target_atoms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "R3-40: the target in quote atoms (raise_target)."
    },
    "raised_atoms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "R3-40: the amount raised in quote atoms (total_commitments)."
    },
    "fill_bps": {
      "type": "integer",
      "minimum": 0
    },
    "participants": {
      "type": "integer",
      "minimum": 0
    },
    "interested": {
      "description": "R3-29: the sale's current presale follows, one per account; an unfollow decrements it and a deleted account never counts. The same for every caller; names nobody.",
      "type": "integer",
      "minimum": 0
    },
    "backers_sample": {
      "description": "Redesign gap 11: up to 3 named backers of the sale's latest 24 commits, the latest first, one per account, under the naming rule; empty when none is named. List and featured pages only.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "callsign": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]{1,18}[a-z0-9]$"
          },
          "display_name": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "avatar_url": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "callsign",
          "display_name",
          "avatar_url",
          "verified"
        ],
        "additionalProperties": false
      }
    },
    "presale_price_usd": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      ]
    },
    "presale_price_quote": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      ],
      "description": "R3-40: the presale price in the quote coin per whole token; null with no claim yet."
    },
    "price_usd": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      ]
    },
    "multiple": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      ]
    },
    "verified_team": {
      "description": "R3-23: Blast checked who is behind the project. Set only by an operator (social_sale_trust); false without a row. Never derived from creator input.",
      "type": "boolean"
    },
    "audited": {
      "description": "R3-23: Blast read the audit report. Set only by an operator; an audit link in the sale's metadata never sets it. False without a row.",
      "type": "boolean"
    },
    "metadata": {
      "description": "R3-24: the sale's public details (cover, tagline, links, published launch date); null when it has none. Never names who wrote them.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://blast-v2.invalid/social/contracts/sale-metadata.schema.json"
        }
      ]
    },
    "quote_type": {
      "description": "The exact on-chain coin type accepted by this presale.",
      "type": "string",
      "minLength": 1
    },
    "sale_decimals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "allowlisted": {
      "type": "boolean"
    },
    "hard_cap": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "coin_type": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical sale coin type; optional for older cached responses."
    }
  },
  "required": [
    "presale_id",
    "name",
    "symbol",
    "icon_url",
    "phase",
    "venue",
    "start_ms",
    "end_ms",
    "ended_ms",
    "launched_ms",
    "target_usd",
    "raised_usd",
    "quote_symbol",
    "quote_decimals",
    "target_atoms",
    "raised_atoms",
    "fill_bps",
    "participants",
    "interested",
    "presale_price_usd",
    "presale_price_quote",
    "price_usd",
    "multiple",
    "verified_team",
    "audited",
    "metadata",
    "quote_type"
  ],
  "additionalProperties": false
}
