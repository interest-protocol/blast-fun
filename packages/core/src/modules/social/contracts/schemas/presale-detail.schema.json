              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          ]
        },
        "wallet_cap_usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          ]
        },
        "min_commitment_atoms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ],
          "description": "R3-40: min_commitment_usd's limit in quote atoms."
        },
        "wallet_cap_atoms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
