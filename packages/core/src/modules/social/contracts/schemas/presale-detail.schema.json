        "verified_team": {
          "description": "R3-23: Blast checked who is behind the project. Set only by an operator (social_sale_trust); false without a row. Never derived from creator input.",
          "type": "boolean"
        },
        "audited": {
          "description": "R3-23: Blast read the audit report. Set only by an operator; an audit link in the sale's metadata never sets it. False without a row.",
          "type": "boolean"
        },
        "metadata": {
          "description": "R3-24: the sale's public details (cover, tagline, links, published launch date); null when it has none. Never names who wrote them.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://blast-v2.invalid/social/contracts/sale-metadata.schema.json"
