{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-v2.invalid/social/contracts/presale-detail.schema.json",
  "title": "Presale detail",
  "description": "GET /api/social/presales/{presale_id} 200: one sale, the same for every caller.",
  "type": "object",
  "properties": {
    "presale": {
      "type": "object",
      "properties": {
        "presale_id": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "name": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "icon_url": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "pending",
            "open",
            "closed",
            "funded",
            "trading",
            "cancelled"
          ]
        },
        "venue": {
          "type": "string"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "ended_ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "launched_ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "target_usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          ]
        },
        "raised_usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          ]
        },
        "quote_symbol": {
          "description": "R3-40: the sale's quote coin (USDC or SUI). A USDC sale reads in dollars (the *_usd fields); any other quote reads in its own coin from the *_atoms figures and quote_decimals.",
          "type": "string",
          "minLength": 1
        },
        "quote_decimals": {
          "type": "integer",
          "minimum": 0
        },
        "target_atoms": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "R3-40: the target in quote atoms (raise_target)."
        },
        "raised_atoms": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "R3-40: the amount raised in quote atoms (total_commitments)."
        },
        "fill_bps": {
          "type": "integer",
          "minimum": 0
        },
        "participants": {
          "type": "integer",
          "minimum": 0
        },
        "interested": {
          "description": "R3-29: the sale's current presale follows, one per account; an unfollow decrements it and a deleted account never counts. The same for every caller; names nobody.",
          "type": "integer",
          "minimum": 0
        },
        "presale_price_usd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          ]
        },
        "presale_price_quote": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          ],
