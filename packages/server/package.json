{
  "name": "@blast/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --no-warnings --import ../../scripts/register-runtime-types.mjs --experimental-strip-types --test --test-concurrency=1 'src/**/!(*.integration).test.ts'",
    "test:integration": "node ../../scripts/test-integration.mjs",
    "social:operator": "node --no-warnings --experimental-strip-types scripts/social-operator.ts"
  },
  "dependencies": {
    "@blast/core": "*",
    "@interest-protocol/blast-sdk": "0.3.0",
    "@interest-protocol/blast-util-sdk": "0.2.0",
    "@mysten/sui": "^3.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@vercel/blob": "^2.8.1",
    "lru-cache": "11.5.3",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "ts-pattern": "5.9.0",
    "undici": "8.12.3",
    "zod": "4.6.7",
    "@cetusprotocol/aggregator-sdk": "1.7.3"
  }
}
