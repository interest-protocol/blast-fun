# Final-stack worker configuration. Set only the signer for this process.
# Secrets live in the service secret store; never commit real values.
# Mainnet identity must match the SDK's released registry and indexer.
BLAST_NETWORK=mainnet
BLAST_DEPLOYMENT_FINGERPRINT=
WATCHER_DATABASE_URL=
# Optional, 1-2 (default 2; the web runtime's DATABASE_*_TIMEOUT_MS budgets apply).
WATCHER_DATABASE_POOL_MAX=
# production or non-production (the SDK's evaluateProtocolAccess mode).
BLAST_WORKER_ENVIRONMENT=
# Non-production only: the deployment manifest JSON file; its sharedObjects are
# grouped by the package that owns them. Production uses the SDK's released
# registry and refuses this.
BLAST_WORKER_DEPLOYMENT_MANIFEST=
# The Sui fullnode (https; loopback http is accepted only outside production).
BLAST_WORKER_SUI_GRPC_URL=
# Optional: Sui GraphQL for the rewards holder identity check (https; loopback
# http only outside production). Unset uses https://graphql.mainnet.sui.io/graphql.
BLAST_WORKER_SUI_GRAPHQL_URL=
# SECRET: the gas-only keeper key (Bech32 Sui Ed25519 private key).
# Owner-provisioned; never commit one.
BLAST_WORKER_SIGNER_KEY=
BLAST_WORKER_POLL_INTERVAL_MS=
# Must exceed CONFIRM + 5 x PROVIDER and POLL + 2 x PROVIDER.
BLAST_WORKER_LEASE_TTL_MS=
BLAST_WORKER_PROVIDER_TIMEOUT_MS=
BLAST_WORKER_CONFIRM_TIMEOUT_MS=
BLAST_WORKER_RETRY_BASE_MS=
BLAST_WORKER_RETRY_MAX_MS=
BLAST_WORKER_MAX_ATTEMPTS=
BLAST_WORKER_BATCH_SIZE=
# Must cover pool creation as well as smaller keeper transactions.
BLAST_WORKER_GAS_BUDGET_MIST=
# Must exceed the gas budget: the alert fires while gas can still pay.
BLAST_WORKER_FUNDING_ALERT_MIST=
# SECRET: HTTPS Discord alert webhook; required by keeper, planner and rewards.
BLAST_WORKER_ALERT_WEBHOOK_URL=
# blast-infra, for a round's bidders and a launch's migration vault (https in production).
BLAST_INFRA_ORIGIN=
# Keeper and buyback: select the committed reader after verifying its deployment.
# Production: committed-markets and https://blast-infra-reader.onrender.com.
BLAST_INFRA_READ_MODE=
BLAST_INFRA_READ_ORIGIN=
# SECRET, when blast-infra requires one.
BLAST_INFRA_API_KEY=
# Bidders per delivery transaction, 1-100, within the gas budget.
BLAST_WORKER_DELIVERY_BATCH_SIZE=
# Owner's value 600000: alert when a round is unsettled 10 minutes after it ends.
BLAST_WORKER_OPENING_ROUND_ALERT_MS=
# Owner's value 86400000: claim each launch's fees daily.
BLAST_WORKER_FEE_CLAIM_INTERVAL_MS=
# Owner's value 5: send a claim only when worth 5x its simulated gas.
BLAST_WORKER_FEE_CLAIM_GAS_MULTIPLE=
# production refuses a non-Neon, plaintext or other-region WATCHER_DATABASE_URL.
# "off" silences the worker's JSON metrics and logs.
MISSION_CONTROL_METRICS=

# The vault buyback-and-burn operator (`start.sh vault-buyback`):
# its own service, with the BLAST_WORKER_* runtime settings above, WITHOUT
# any other *_SIGNER_KEY (it refuses to start beside
# another key). docs/launchpad/runbooks/buyback-key.md.
# SECRET: the dedicated buyback key (Bech32 Sui Ed25519 private key).
BLAST_BUYBACK_SIGNER_KEY=
# The key's dedicated AdminCap, granted BuybackAdmin only.
BLAST_BUYBACK_ADMIN_CAP_ID=
# SECRET: the operators' alert webhook (Discord in production).
BLAST_BUYBACK_ALERT_WEBHOOK_URL=
# blast-infra, as for the web server: BLAST_INFRA_ORIGIN and SECRET BLAST_INFRA_API_KEY.
# Owner defaults; leave unset unless the owner changes them.
BLAST_BUYBACK_MIN_USD=50
BLAST_BUYBACK_MAX_POOL_SHARE_BPS=100
BLAST_BUYBACK_MAX_PIECES_PER_DAY=8
BLAST_BUYBACK_MIN_PIECE_GAP_MS=900000
BLAST_BUYBACK_SLIPPAGE_BPS=1000
BLAST_BUYBACK_TWAP_WINDOW_MS=1800000
BLAST_BUYBACK_REFERENCE_MAX_LAG_MS=30000
BLAST_BUYBACK_USD_MAX_AGE_MS=300000
BLAST_BUYBACK_ABORT_ALERT_AFTER=2
BLAST_BUYBACK_DISCOVERY_MAX_PAGES=50
# The worker:release-gate command's buyback identity (no key): the buyback address, public.
BLAST_BUYBACK_SIGNER_ADDRESS=

# Keeper only: dedicated gas key above; no role or cap.
GAS_POOL_SPONSOR_ADDRESS=
GAS_POOL_LOW_BALANCE_MIST=50000000000
# Owner-selected maximum Bluefin pool creation fee, paid from keeper address balance.
# Default 0 refuses a nonzero fee; no protocol role is needed.
BLAST_WORKER_BLUEFIN_CREATION_FEE_CAP_MIST=0

# Rewards executor only. One core RewardsAdmin for both origins.
VAULT_REWARDS_SIGNER_KEY=
VAULT_REWARDS_ADMIN_CAP_ID=
VAULT_REWARDS_RELAY_BATCH=1023
# Planner only: pooled primary login holding blast_indexer; no signer or cap.
# Also requires common BLAST_WORKER_* runtime settings and HTTPS alert webhook above.
REWARDS_PLANNER_DATABASE_URL=
REWARDS_BLOB_TOKEN=
# Explicit policy required by planner and executor; owner chooses go-live values.
REWARDS_PRICE_MAX_AGE_MS=
REWARDS_PRICE_MAX_CONFIDENCE_BPS=
# Optional planner settings; <=909 bps of gross Quote, <=10% of holder Quote.
REWARDS_GAS_RESERVE_BPS=0
REWARDS_EXCLUSIONS=[]
REWARDS_NO_MINIMUM_VAULTS=[]
# Optional epoch milliseconds for the catch-up cut and new daily window anchor.
REWARDS_CATCH_UP_AT_MS=
# Public signer identities for the keyless worker:release-gate command only (keeper, rewards).
BLAST_WORKER_SIGNER_ADDRESS=
VAULT_REWARDS_SIGNER_ADDRESS=
