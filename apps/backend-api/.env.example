# Public sources remain Render; database credentials/regions stay unchanged.
BLAST_INFRA_ORIGIN=https://api.blast.fun
BLAST_INFRA_API_KEY=<existing-server-only-infra-key>
DATABASE_URL=<existing-primary-pooled-url>
# Same primary/database, distinct narrowly granted LOGIN inheriting blast_partner_verifier.
PARTNER_VERIFIER_DATABASE_URL=<partner-verifier-primary-pooled-url>
DATABASE_REPLICA_URL=<existing-replica-pooled-url>
BLAST_QUOTA_REDIS_URL=<existing-quota-redis-url>
BLAST_CACHE_REDIS_URL=<existing-separate-cache-redis-url>
BLAST_REDIS_NAMESPACE=<existing-network-deployment-environment-namespace>
RATE_LIMIT_SUBJECT_PEPPER=<existing-secret-do-not-rotate>
BLAST_DEPLOYMENT_TARGET=production
# Required outside production:
# BLAST_DEPLOYMENT_BRANCH=feature-x
BLAST_BACKEND_EXPECTED_QUOTA_NAMESPACE=<existing-derived-64-hex-quota-namespace>
BLAST_BACKEND_GATEWAY_SECRET=<new-server-only-gateway-secret-at-least-32-characters>
NEXT_PUBLIC_SITE_URL=https://www.blast.fun
PORT=8080
BLAST_BACKEND_LISTEN_HOST=0.0.0.0
# Required explicit measured capacity/reservation JSON; no production value is inferred.
BLAST_PARTNER_CAPACITY_CONFIG=<reviewed-capacity-json-covering-all-active-entitlements>
# Optional: one registry's replicas share this store, independently of branch quotas.
# BLAST_PARTNER_RECOGNITION_NAMESPACE=<existing-registry-64-hex-namespace>
BLAST_BACKEND_MAX_INFLIGHT=64
# Optional presale follow reads reserve pool capacity for buyer positions.
# The fleet limit is shared by processes connected to the same read replica.
BLAST_PRESALE_FOLLOW_FLEET_LIMIT=4
BLAST_PRESALE_FOLLOW_PROCESS_LIMIT=2
# Optional connected activity SSE capacity per replica; default 200, range 1..512.
BLAST_BACKEND_MAX_HINT_STREAMS=200
BLAST_BACKEND_MAX_ADMIN_INFLIGHT=4
# Existing server-only operator bearer; migration does not rotate it:
PRESALE_ADMIN_TOKEN=<existing-server-only-operator-token>
PRESALE_GAS_POOL_URL=https://gas-pool.onrender.com
# Explicit ingress mode is required. Direct ignores all forwarded client headers.
# For Render, select trusted-proxy only after verifying its actual overwrite contract.
BLAST_BACKEND_INGRESS_MODE=trusted-proxy
BLAST_BACKEND_TRUSTED_PROXY_CIDRS=<verified-narrow-proxy-cidrs>
# Local direct socket example: BLAST_BACKEND_INGRESS_MODE=direct (omit CIDRs).
# Preserve existing manifest/fingerprint/network settings.

# Optional DefiLlama partner reads. Set both on the API process.
# Use a dedicated reporting reader, without source or publisher privileges.
# Profile and fleet provisioning: docs/launchpad/defillama-api-design.md.
DEFILLAMA_READ_DATABASE_URL=
DEFILLAMA_PROFILE=

# Optional complete committed reader; leave MODE empty for hot-memory writer reads.
# Enable committed-markets only after complete local route/WS verification.
BLAST_INFRA_READ_MODE=
BLAST_INFRA_READ_ORIGIN=

# Same server-only gate key as Next; required for cross-process cookie refresh.
BLAST_GATE_SECRET=<same-server-only-gate-key-at-least-32-characters>
BLAST_GATE_SECRET_PREVIOUS=<optional-previous-gate-key-for-two-hour-rotation>

# Dedicated attempt acknowledgement; distinct from PRESALE_ADMIN_TOKEN, never a fallback.
ADMIN_LOGIN_ADMISSION_TOKEN=<dedicated-server-only-login-admission-token-at-least-32-characters>

# Optional for legacy API; required for the isolated hints profile. Both roles use
# the same reviewed JSON; see docs/architecture/latency-and-capacity.md.
# BLAST_BACKEND_FLEET_CONFIG=<explicit-fleet-envelope-not-a-capacity-claim>

# Optional public launch images and social profile photos. Configure on this
# backend process, which owns upload handlers; never expose it as NEXT_PUBLIC_.
# Use a token for the existing PUBLIC Blob store. Empty means uploads are off.
# BLOB_READ_WRITE_TOKEN belongs to private card storage and is not a fallback.
LAUNCH_ASSET_BLOB_READ_WRITE_TOKEN=

# Optional dedicated offchain creator-account attestation key (API only, never hints).
# Register its 32-byte Ed25519 public key in launchpad RuntimeConfig separately.
CREATOR_CLAIM_SIGNER_KEY=
