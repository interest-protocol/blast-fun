# Separate process: bun run src/hints-main.ts (or npm run start:hints).
# Omit API database, partner, operator, signer and main gateway credentials.
NODE_ENV=production
BLAST_DEPLOYMENT_TARGET=production
NEXT_PUBLIC_SITE_URL=https://www.blast.fun
BLAST_REDIS_NAMESPACE=<existing-network-deployment-environment-namespace>
BLAST_BACKEND_EXPECTED_QUOTA_NAMESPACE=<existing-derived-64-hex-quota-namespace>
BLAST_QUOTA_REDIS_URL=<existing-quota-redis-url>
RATE_LIMIT_SUBJECT_PEPPER=<existing-secret-do-not-rotate>
BLAST_BACKEND_HINTS_GATEWAY_SECRET=<distinct-hints-only-secret-at-least-32-characters>
BLAST_INFRA_ORIGIN=https://api.blast.fun
BLAST_INFRA_API_KEY=<existing-server-only-infra-key>
# Required: the hints WebSocket connects only to the complete committed reader
# (the writer serves no /v1/ws); without both the process refuses to start.
BLAST_INFRA_READ_MODE=committed-markets
BLAST_INFRA_READ_ORIGIN=<verified-committed-reader-origin>
BLAST_BACKEND_FLEET_CONFIG=<same-reviewed-envelope-as-api-role>
# Live sockets per replica; match envelope.hints.maxHintStreams. Default 200, maximum 1,024.
BLAST_BACKEND_MAX_HINT_STREAMS=200
BLAST_BACKEND_MAX_INFLIGHT=64
BLAST_BACKEND_MAX_ADMIN_INFLIGHT=4
# Optional committed price/candle live socket. The matching fleet envelope must set
# hints.marketStream=true and declare marketSubscribedTabs; see
# docs/architecture/continuous-market-data.md for sharing and capacity bounds.
BLAST_BACKEND_MARKET_STREAM_ENABLED=false
# Required only when enabling market streams; use the actual existing deployment.
# BLAST_NETWORK=mainnet
# BLAST_DEPLOYMENT_FINGERPRINT=<existing-64-hex-deployment-fingerprint>
BLAST_BACKEND_LISTEN_HOST=0.0.0.0
PORT=8080
BLAST_BACKEND_INGRESS_MODE=trusted-proxy
BLAST_BACKEND_TRUSTED_PROXY_CIDRS=<verified-narrow-proxy-cidrs>
