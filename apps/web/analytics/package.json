{
  "name": "blast-private-analytics",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "prestart": "npm run prepare",
    "start": "node src/server.ts",
    "pretypecheck": "npm run prepare",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prepare",
    "test": "node --test --test-concurrency=1 src/*.test.ts",
    "pretest:integration": "npm run prepare",
    "test:integration": "node --test --test-concurrency=1 test/warehouse.integration.test.ts",
    "pretest:contract": "npm run prepare",
    "test:contract": "node --test --test-concurrency=1 test/contract.test.ts",
    "pretest:artifact": "npm run prepare",
    "test:artifact": "node scripts/check-artifact.mjs"
  },
  "dependencies": {
    "pg": "8.23.1",
    "zod": "4.6.7",
    "lightweight-charts": "5.2.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
