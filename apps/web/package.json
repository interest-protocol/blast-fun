{
  "name": "@blast/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run generate:site-theme-colors -- --check && npm run generate:relay-routes -- --check && npm run check:partner-v1 && TURBO_TASKS_AVAILABLE_PARALLELISM=${TURBO_TASKS_AVAILABLE_PARALLELISM:-2} next build",
    "db:cleanup": "node --no-warnings --experimental-strip-types scripts/mission-control.ts cleanup",
    "db:migrate": "node --no-warnings --experimental-strip-types scripts/mission-control.ts migrate",
    "db:reset": "node --no-warnings --experimental-strip-types scripts/mission-control.ts reset",
    "dev": "next dev",
    "generate:site-theme-colors": "node scripts/generate-site-theme-colors.mjs",
    "generate:relay-routes": "node --no-warnings --experimental-strip-types scripts/generate-relay-routes.ts",
    "doctor:react": "npx --yes react-doctor@0.9.17 . --verbose --scope full --no-parallel --blocking warning",
    "doctor:react:diff": "npx --yes react-doctor@0.9.17 . --verbose --scope changed --base origin/main --include-untracked --no-parallel --blocking warning",
    "launchpad:moderate": "node --no-warnings --experimental-strip-types scripts/launchpad-moderation.ts",
    "presale:api-keys": "node --no-warnings --experimental-strip-types ../../packages/server/scripts/presale-api-keys.ts",
    "partner:api-keys": "node --no-warnings --experimental-strip-types scripts/partner-api-keys.ts",
    "presale:bridge-activation": "node --no-warnings --import ../../scripts/test-tsx-hooks.mjs --experimental-strip-types scripts/presale-bridge-activation.ts",
    "presale:release-check": "node --no-warnings --import ../../scripts/test-tsx-hooks.mjs --experimental-strip-types scripts/presale-release-check.ts",
    "competitions": "node --no-warnings --experimental-strip-types scripts/competitions.ts",
    "swaps:track": "node --no-warnings --experimental-strip-types scripts/swap-tracking.ts",
    "start": "next start",
    "test": "node --no-warnings --import ../../scripts/test-tsx-hooks.mjs --test --experimental-strip-types 'loadtest/**/*.test.mjs' 'src/**/!(*.integration|*.external).test.ts' 'src/**/!(*.integration|*.external).test.tsx' 'test/**/!(*.integration|*.external).test.ts' 'test/**/!(*.integration|*.external).test.tsx'",
    "test:integration": "node ../../scripts/test-integration.mjs",
    "test:shell-typography": "node --test --test-concurrency=1 test/fixtures/workspace/verify-shell-typography.mjs",
    "test:coin-price-row": "node --test --test-concurrency=1 test/fixtures/workspace/verify-coin-price-row.mjs",
    "test:workspace-layout": "node --test --test-concurrency=1 test/fixtures/workspace/layout/verify.mjs",
    "test:portfolio-fixture": "test -n \"$T020_CONFIG_DIR\" || { echo \"T020_CONFIG_DIR must name the prepared Portfolio fixture configuration\" >&2; exit 1; }; node --no-warnings --import ../../scripts/test-tsx-hooks.mjs --test --experimental-strip-types src/components/social/blast-mode/workspace/PortfolioData.fixture.external.test.ts",
    "typecheck": "tsc --noEmit",
    "check:partner-v1": "env -i PATH=\"$PATH\" node --no-warnings --import ../../scripts/test-tsx-hooks.mjs --test --test-concurrency=1 --experimental-strip-types src/modules/partner-api/v1/*.test.ts ../../packages/server/src/modules/partner-api/v1/route.test.ts ../../packages/server/src/modules/partner-api/v1/runtime.test.ts",
    "check:partner-live": "node scripts/partner-api-live/run.mjs",
    "test:live-probe": "node --test scripts/live-probe/*.test.mjs",
    "test:partner-live": "node --test --test-concurrency=1 scripts/partner-api-live/*.test.mjs",
    "defillama:publish": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/defillama-publish.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@blast/core": "*",
    "@blast/server": "*",
    "@cetusprotocol/aggregator-sdk": "1.7.3",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/reenie-beanie": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@interest-protocol/blast-sdk": "0.3.0",
    "@interest-protocol/blast-util-sdk": "0.2.0",
    "@mayanfinance/swap-sdk": "16.1.0",
    "@mysten/dapp-kit-react": "^3.0.1",
    "@mysten/move-bytecode-template": "^0.4.1",
    "@mysten/slush-wallet": "^2.0.1",
    "@mysten/sui": "^3.0.1",
    "@noble/hashes": "^2.4.0",
    "@privy-io/react-auth": "3.52.0",
    "@resvg/resvg-js": "2.6.2",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-query": "^5.104.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.1",
    "@vercel/speed-insights": "^2.0.0",
    "@wallet-standard/app": "1.1.1",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "klinecharts": "10.1.1",
    "lightweight-charts": "5.2.1",
    "lru-cache": "11.5.3",
    "motion": "^14.0.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-virtuoso": "^4.18.16",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "styled-components": "^6.5.3",
    "ts-pattern": "5.9.0",
    "typescript": "7.0.2",
    "undici": "8.12.3",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "6.0.2",
    "ajv": "8.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "lightningcss": "1.33.0",
    "playwright-core": "1.64.1",
    "vite": "8.3.5"
  },
  "imports": {
    "#web/scripts/*": "./scripts/*",
    "#web/test/*": "./test/*",
    "#web/*": "./src/*"
  },
  "type": "module"
}
