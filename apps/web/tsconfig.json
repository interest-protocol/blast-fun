{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "checkers": 1,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "#web/scripts/*": [
        "./scripts/*"
      ],
      "#web/test/*": [
        "./test/*"
      ],
      "#web/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "analytics"
  ]
}
