# Blast web environment. Copy to .env.local for local work; never commit
# real values. Secrets marked "server-only" must not use the NEXT_PUBLIC_ prefix.

# --- Site -------------------------------------------------------------------
# Exact public origin; mutation guards compare the request Origin against it.
# For Next dev, open the app at localhost using the configured port. Use the
# same origin in the local backend relay configuration.
# Read at build time, so rebuild after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enables the legacy Mission Control account recovery and owner APIs.
BLAST_EXPERIENCE_ENABLED=false
# Optional direct Boosts link in the launchpad header. Server-only. Shown only
# for an absolute https URL on a public multi-label host (not localhost, .local,
# .internal or an IP) without credentials.
BLAST_BOOSTS_URL=
# Social feed trading surfaces (buy and sell posts, "Buy too", coin holdings)
# stay hidden until R1 (owner decision OA-7): set exactly true to show them.
# Server-only; restart after changing it. Unset (the default) hides them;
# The historical team value also enables them.
BLAST_TRADING_ENABLED=
# The coin page's live trading screen: header numbers and lists follow the
# market stream, and the page stops re-reading itself on a timer. Set exactly
# true to turn it on. Server-only; unset (the default) keeps today's page.
BLAST_LIVE_SCREEN_ENABLED=
# Share (0 to 1) of answered /api/social/* requests below 500 that log a
# `social.route` duration metric; every 5xx is logged. Default 0.1.
SOCIAL_ROUTE_METRIC_SAMPLE_RATE=

# --- Database ---------------------------------------------------------------
# One Neon database shared with blast-infra (docs/mission-control/capacity.md,
# "Shared Neon runtime"). Server-only: never add a NEXT_PUBLIC_ prefix. Each is
# checked at use and fails closed; nothing falls back to another endpoint.
# Primary, POOLED endpoint (host contains "-pooler"), sslmode=verify-full, as the
# runtime login that holds blast_web: writes, social and sensitive reads.
DATABASE_URL=
# Read replica, POOLED endpoint, same database and region, as a login that
# holds blast_replica: search and thesis chain joins.
DATABASE_REPLICA_URL=
# Primary, DIRECT endpoint (no "-pooler"), as the migration login (not the
# runtime one): npm run db:migrate and db:reset. Locally DATABASE_URL is used.
DATABASE_MIGRATION_URL=
# The watcher is its own process with its own login and small pool on the
# primary (WATCHER_DATABASE_URL); the web app never reads that variable. Its
# variables, including its gas key, live in apps/workers/.env.example, never here.
# blast-infra, server-only (WP2). The browser never talks to blast-infra: the
# coin page reads Holders, the chart and Activity through this app's
# same-origin /api/launchpad/market/* routes, which relay each /v1 read, and
# the page CSP admits no blast-infra origin. Never prefix these NEXT_PUBLIC_.
# BLAST_INFRA_ORIGIN: one bare http(s) origin (https in production) naming a
# DNS host or IP address; a wildcard such as https://*.example.com is refused.
# NEXT_PUBLIC_BLAST_INFRA_ORIGIN is no longer read anywhere: delete it from
# every deployment.
# Hosted production backend (Render). For a local indexer, set your local
# origin in .env.local instead. Do not change database/manifest identity to
# match a hosting provider; see docs/deploy/RENDER.md.
BLAST_INFRA_ORIGIN=https://api.blast.fun
# Optional complete committed reader, only after market/presale/WS verification.
# Leave MODE empty to retain the intentional hot-memory writer read path.
# Set MODE to committed-markets with a separately verified server-only origin.
BLAST_INFRA_READ_ORIGIN=
BLAST_INFRA_READ_MODE=
# Required standalone backend for all partner and selected first-party public reads.
# For local workflows, run the Bun backend and set its loopback origin.
# Never expose this secret or the backend's infra credential in NEXT_PUBLIC variables.
BLAST_BACKEND_API_ORIGIN=
BLAST_BACKEND_GATEWAY_SECRET=
# BLAST_INFRA_API_KEY (secret): sent on every server and worker request to
# blast-infra in x-blast-infra-key: the configured writer, or the explicit
# complete committed-reader selection above. Never forwarded to arbitrary hosts.
# 32 to 512 printable characters without spaces. blast-infra checks it on
# every /v1 and /v1/ws request (its own rotation keeps a next key beside it;
# this app sends one). Unset sends none, which a keyed blast-infra refuses.
BLAST_INFRA_API_KEY=
# Gas sponsor on Render. Server-only; this URL alone enables no sponsorship.
# Use the existing service credential from the authorized secret source.
PRESALE_GAS_POOL_URL=https://gas-pool.onrender.com
PRESALE_GAS_POOL_TOKEN=
# The Blast deployment this app serves: its SDK manifest's network and
# deploymentFingerprint, set together. Blast deploys to Sui mainnet only, so
# BLAST_NETWORK is mainnet. A /v1 answer or
# chain_read_v1.watermark row naming another deployment is Unavailable. Unset,
# provenance is reported but not compared.
BLAST_NETWORK=
BLAST_DEPLOYMENT_FINGERPRINT=
# Signs creator-cap claims for launches whose creator recipient is a Blast
# account (POST /api/social/me/creator-caps). A Sui `suiprivkey1...` Ed25519
# key whose public key RuntimeConfig.creator_claim_signer_public_key holds
# (`runtime_config::set_creator_claim_signer`). Unset, account claims are off;
# address-recipient claims never need it. Server-only secret.
CREATOR_CLAIM_SIGNER_KEY=
# Per-instance pool and server-side limits (see docs/mission-control/capacity.md).
# Pool: instances x DATABASE_POOL_MAX must stay under the Neon pooler's 10,000
# client connections (e.g. 50 instances x 10 = 500). PostgreSQL backends are
# bounded separately by the pooler's pool size for the compute.
DATABASE_POOL_MAX=10
# The replica pool's own size, 1-50.
DATABASE_REPLICA_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=8000
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# Optional shared public-read cache and partner traffic quota stores (server-only).
# Distinct authenticated TLS URLs. Never use an evicting cache for quotas.
# Cache failure falls back to source; configured quota failure refuses traffic.
BLAST_CACHE_REDIS_URL=
BLAST_QUOTA_REDIS_URL=
# Required with Redis: stable network/deployment/environment identity. Production
# and previews MUST use distinct namespaces; changing it resets quota allowances.
BLAST_REDIS_NAMESPACE=

# --- Legacy owner cursors (server-only secrets) ----------------------------
# 32-byte base64 key. Used when OWNER_CURSOR_KEY is unset.
COMPLETION_SESSION_TOKEN_KEY=
# At least 32 characters; keys rate-limit subjects.
RATE_LIMIT_SUBJECT_PEPPER=
# At least 32 characters, server-only: signs the first-party API gate cookie
# (docs/security/bot-protection.md). In production every /api call answers
# 503 gate_unavailable without it. To rotate, set the new value here and the
# old one in BLAST_GATE_SECRET_PREVIOUS for two hours (the cookie's lifetime).
BLAST_GATE_SECRET=
BLAST_GATE_SECRET_PREVIOUS=
# Platform-wide sponsored-gas caps per UTC day (whole numbers 1 to 10000000):
# reservations (POST /api/presale/sponsor, default 20000) and executions
# (POST /api/presale/sponsor/{id}/execute, default 5000).
PRESALE_SPONSOR_DAILY_CAP=
PRESALE_SPONSOR_EXEC_DAILY_CAP=
# At least 32 characters; keys the launchpad's opaque Privy subject hash
# (docs/launchpad/identity.md). Changing it changes every Privy actor's key.
# Launchpad writes answer 503 without it.
LAUNCHPAD_SUBJECT_PEPPER=
# Minutes the maintenance cleanup keeps a verified-outcome digest commitment
# that no report decided, launchpad and presale alike (docs/launchpad/telemetry.md,
# docs/presale/outcomes.md). Optional; default 60,
# never longer than the 90-day reporting retention.
LAUNCHPAD_OUTCOME_COMMITMENT_WINDOW_MINUTES=
# Optional; recruit-list cursor signing key.
OWNER_CURSOR_KEY=
# Optional member session lifetimes in days.
MEMBER_SESSION_IDLE_DAYS=
MEMBER_SESSION_ABSOLUTE_DAYS=

# --- Privy (server-only) ------------------------------------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# PEM of the app's ES256 verification key (\n escapes allowed).
PRIVY_JWT_VERIFICATION_KEY=
# Load tests only: a loopback mock origin such as http://127.0.0.1:4010.
PRIVY_API_BASE_URL=
# Privy calls in flight per instance (default 16, 1–256); extra callers wait up to 3 s.
PRIVY_MAX_CONCURRENCY=16

# --- Card images ----------------------------------------------------------------
# Vercel Blob store token (set by the Vercel Blob integration). When unset,
# CARD_IMAGE_DIRECTORY (local disk) or memory is used.
BLOB_READ_WRITE_TOKEN=
# private (default) or public.
CARD_IMAGE_BLOB_ACCESS=private
# Local/load-test store directory.
CARD_IMAGE_DIRECTORY=
# Per-instance in-memory image cache, in bytes (default 64 MiB).
CARD_IMAGE_MEMORY_CACHE_BYTES=67108864
# Card renders run at once per instance (default 2, 1–8) and renders that may
# wait for a slot (default 16, 0–64). Beyond that the route answers 503.
CARD_RENDER_CONCURRENCY=2
CARD_RENDER_QUEUE=16

# --- Launch images ---------------------------------------------------------------
# Token of a PUBLIC Vercel Blob store for validated launch images
# (docs/launchpad/launch-creation.md). Without it, uploads answer 503.
LAUNCH_ASSET_BLOB_READ_WRITE_TOKEN=

# --- Background work -------------------------------------------------------
# Vercel Cron bearer secret (16+ characters). Without it cron routes return 401.
CRON_SECRET=

# --- Operations ----------------------------------------------------------------------
# "off" silences the one-line JSON metrics.
MISSION_CONTROL_METRICS=
BLAST_OPERATOR_ID=
BLAST_OPERATOR_TOKEN=
MISSION_CONTROL_OPERATOR_ALLOWED_ID=
MISSION_CONTROL_OPERATOR_TOKEN_SHA256=

# --- Presale gas sponsorship ------------------------------------------------------
# Cetus swap targets the sponsor pays for in a commit-with-swap: comma-separated
# <package>::<module> entries, e.g. the aggregator's router and each DEX adapter
# module its routes call. A module admits only the functions derived in
# packages/core/src/modules/sponsor/swap-calls.ts. Empty sponsors no swap. 0x1/0x2
# entries are refused; framework calls come from framework-calls.ts.
PRESALE_SPONSOR_SWAP_TARGETS=

# --- Blast app fee on social trades (owner, 2026-10-08) ----------------------------
# Server only. Whole basis points of every in-app trade's output, 0 to 1000 (30 is
# 0.3%), and the canonical Sui address it is paid to (0x + 64 lowercase hex, not 0x0).
# The Cetus aggregator takes it from the swap's output coin inside the swap. Both
# empty, or 0 bps: no fee. Only one set, or an invalid value: trade quotes and swaps
# answer 503, and the sponsor sponsors no trade. Never commit a real treasury address.
BLAST_TRADE_FEE_BPS=
BLAST_TRADE_FEE_RECEIVER=

# --- Presale account settings -------------------------------------------------------
# What GET /api/account/settings returns, with saved: false, for an account that
# has saved nothing. Explorer: suivision or suiscan. Theme: system, dark or light.
# Empty uses the shipped default; any other value fails that read (503).
PRESALE_DEFAULT_EXPLORER=suivision
PRESALE_DEFAULT_THEME=system

# Set on the backend API process that supplies creation context and publication routes.

# Server-only bearer shared with the password-protected admin console.
# Use a random secret of at least 32 characters; never NEXT_PUBLIC_ or VITE_.
PRESALE_ADMIN_TOKEN=

# Optional isolated activity hints. Set both together; invalid configuration fails closed.
# Server-only; never use NEXT_PUBLIC_ names for these credentials.
# BLAST_BACKEND_HINTS_ORIGIN=https://<reviewed-hints-host>
# BLAST_BACKEND_HINTS_GATEWAY_SECRET=<distinct-hints-only-secret-at-least-32-characters>
# The browser's direct market socket on the hints process; its tickets are signed with the
# hints secret above. Unset turns live data off: tabs stay on their polls.
# BLAST_LIVE_SOCKET_URL=wss://<live-host>/v1/socket
